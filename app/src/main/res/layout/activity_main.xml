<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escanear dorso con la cámara" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="O cargalo a mano desde las líneas del dorso:"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:background="#14000000"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etDocNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nro. documento (9 caracteres tras IEPRY)"
            android:inputType="textCapCharacters|textNoSuggestions" />

        <EditText
            android:id="@+id/etBirth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nacimiento AAMMDD (ej. 900305)"
            android:inputType="number"
            android:maxLength="6" />

        <EditText
            android:id="@+id/etExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vencimiento AAMMDD (ej. 330112)"
            android:inputType="number"
            android:maxLength="6" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Modo diagnóstico (sin datos: ver cómo es el chip)" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Escaneá el dorso o completá los datos, y después apoyá la cédula en la parte trasera del celular."
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="160dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
